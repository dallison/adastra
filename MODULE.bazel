module(
    name = "adastra",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "abseil-cpp", version = "20250814.1", repo_name = "com_google_absl")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2", repo_name = "com_google_googletest")
bazel_dep(name = "protobuf", version = "34.1", repo_name = "com_google_protobuf")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_shell", version = "0.8.0")

# protobuf pulls in rules_android 0.6.4 and rules_go 0.51, neither of which
# loads under Bazel 9.
single_version_override(
    module_name = "rules_go",
    version = "0.61.0",
)

single_version_override(
    module_name = "rules_android",
    version = "0.7.2",
)

bazel_dep(name = "coroutines", version = "3.3.5")
bazel_dep(name = "cpp_toolbelt", version = "2.1.5", repo_name = "toolbelt")
bazel_dep(name = "subspace", version = "3.2.2")

# The following are not in the BCR; fetch releases from GitHub.
bazel_dep(name = "phaser", version = "2.1.2")
archive_override(
    module_name = "phaser",
    integrity = "sha256-v1otsz4wb6xIs6hAwAwimltSoJYFiNK7GFbTInpH0Rw=",
    strip_prefix = "phaser-2.1.2",
    urls = ["https://github.com/dallison/phaser/archive/refs/tags/2.1.2.tar.gz"],
)

bazel_dep(name = "retro", version = "1.1.0")
archive_override(
    module_name = "retro",
    integrity = "sha256-gypqOKhu0CTFumNECp0O0JiRUmCNIR+megK7iHt3vUk=",
    strip_prefix = "retro-1.1.0",
    urls = ["https://github.com/dallison/retro/archive/refs/tags/1.1.0.tar.gz"],
)

# neutron 1.0.3 predates Bazel 9 and the BCR versions of toolbelt; the patch
# replaces its MODULE.bazel and adds the rule loads that Bazel 9 requires.
bazel_dep(name = "neutron", version = "1.0.3")
archive_override(
    module_name = "neutron",
    integrity = "sha256-XNpB6mZSbpctyRSLXNMgw7KroXLplZdQzTZRs+LwzG8=",
    patch_strip = 1,
    patches = ["//patches:neutron_bazel9.patch"],
    strip_prefix = "neutron-1.0.3",
    urls = ["https://github.com/dallison/neutron/archive/refs/tags/1.0.3.tar.gz"],
)

# For local debugging of any of the above, replace the override with e.g.:
# local_path_override(
#     module_name = "subspace",
#     path = "../subspace",
# )
